rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isMemberDoc(userId) {
      return exists(/databases/$(database)/documents/members/$(userId));
    }

    function getUserRole() {
      return (isAuthenticated() && isMemberDoc(request.auth.uid))
        ? get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role
        : 'member';
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email in ['bosah3064@gmail.com', 'lame3064@gmail.com', 'admin@onefellowship.org'] ||
        getUserRole() in ['admin', 'superadmin']
      );
    }

    function isExecutive() {
      return isAuthenticated() && (
        isAdmin() ||
        getUserRole() in ['treasury', 'chairperson', 'vice_chairperson']
      );
    }

    // =========================================================================
    // MEMBERS COLLECTION
    // Document ID matches the user's Firebase Auth UID
    // =========================================================================
    match /members/{memberId} {
      // Any authenticated user can read directory
      allow read: if isAuthenticated();

      // Authenticated users can create their own member record or executives can create members
      allow create: if isAuthenticated() && (isOwner(memberId) || isExecutive());

      // Users can update their own profile and form_details.
      // Executives and admins can update all fields.
      allow update: if isAuthenticated() && (
        isExecutive() || 
        isOwner(memberId)
      );

      // Only admins can delete members
      allow delete: if isAdmin();
    }

    // =========================================================================
    // PAYMENTS COLLECTION
    // =========================================================================
    match /payments/{paymentId} {
      // Members can read their own payments; executives can read all payments
      allow read: if isAuthenticated() && (
        isExecutive() || 
        resource.data.member_id == request.auth.uid
      );

      // Executives can record, edit, or delete payments
      // Authenticated users can record a pending payment for themselves
      allow create: if isAuthenticated() && (
        isExecutive() || 
        request.resource.data.member_id == request.auth.uid
      );
      
      allow update, delete: if isExecutive();
    }

    // =========================================================================
    // NOTIFICATIONS COLLECTION
    // =========================================================================
    match /notifications/{notificationId} {
      // Members can read notifications sent to 'all' or to their specific UID
      allow read: if isAuthenticated() && (
        resource.data.recipient == 'all' || 
        resource.data.recipient == request.auth.uid ||
        isExecutive()
      );

      // Users can mark notifications as read
      allow update: if isAuthenticated() && (
        isExecutive() ||
        (resource.data.recipient == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_read']))
      );

      // Executives can broadcast and manage notifications
      allow create, delete: if isExecutive();
    }

    // =========================================================================
    // ORGANIZATION EXPENSES COLLECTION
    // =========================================================================
    match /organization_expenses/{expenseId} {
      allow read: if isAuthenticated();
      allow write: if isExecutive();
    }

    // =========================================================================
    // FORM SCHEMA COLLECTION
    // =========================================================================
    match /form_schema/{schemaId} {
      allow read: if isAuthenticated();
      allow write: if isExecutive();
    }
  }
}
