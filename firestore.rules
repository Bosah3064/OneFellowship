rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS & ROLE DEFINITIONS
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isMemberDoc(userId) {
      return exists(/databases/$(database)/documents/members/$(userId));
    }

    function getUserData() {
      return (isAuthenticated() && isMemberDoc(request.auth.uid))
        ? get(/databases/$(database)/documents/members/$(request.auth.uid)).data
        : {};
    }

    function getUserRole() {
      return getUserData().get('role', 'member');
    }

    function isSuperAdminEmail() {
      return isAuthenticated() && (
        request.auth.token.email in [
          'bosah3064@gmail.com',
          'lame3064@gmail.com',
          'admin@onefellowship.org'
        ]
      );
    }

    // Administrator: Operations, Registry, Notifications, Feedback & Audit Trails
    function isAdmin() {
      return isAuthenticated() && (
        isSuperAdminEmail() ||
        getUserRole() in ['admin', 'superadmin']
      );
    }

    // Chairperson: Supreme Executive Authority & Disciplinary Oversight
    function isChairperson() {
      return isAuthenticated() && (
        isSuperAdminEmail() ||
        getUserRole() in ['chairperson', 'chairman']
      );
    }

    // Treasury: Financial Custodian & Ledger
    function isTreasury() {
      return isAuthenticated() && (
        getUserRole() in ['treasury', 'treasurer']
      );
    }

    // General Leadership: Admin, Chairperson, Treasury, or Executive Committee
    function isLeadership() {
      return isAuthenticated() && (
        isAdmin() ||
        isChairperson() ||
        isTreasury() ||
        getUserRole() in ['secretary', 'vice_chairperson', 'official']
      );
    }

    // =========================================================================
    // 1. MEMBERS COLLECTION (Registry, KYC, Status)
    // =========================================================================
    match /members/{memberId} {
      // Authenticated members can read directory profiles
      allow read: if isAuthenticated();

      // Authenticated users can create their own member record or leadership can provision
      allow create: if isAuthenticated() && (isOwner(memberId) || isLeadership());

      // Profile updates:
      // - Leadership (Admin/Chairperson) can update all fields including role and status
      // - Members can update their personal profile details (contact, form_details, themes, KYC),
      //   but cannot self-elevate roles or un-terminate their own account status
      allow update: if isAuthenticated() && (
        isAdmin() ||
        isChairperson() ||
        (
          isOwner(memberId) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'is_terminated', 'terminated_at']))
        ) ||
        (isTreasury() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'is_terminated']))
      );

      // Only Chairperson or Superadmin can permanently delete member records
      allow delete: if isChairperson() || isAdmin();
    }

    // =========================================================================
    // 2. PAYMENTS COLLECTION (Contributions, Registration Fees, Payouts)
    // =========================================================================
    match /payments/{paymentId} {
      // Members can read their own payments; leadership can read all payments
      allow read: if isAuthenticated() && (
        isLeadership() || 
        resource.data.member_id == request.auth.uid
      );

      // Leadership can record payments; members can record pending submissions for themselves
      allow create: if isAuthenticated() && (
        isLeadership() || 
        request.resource.data.member_id == request.auth.uid
      );
      
      // Leadership can reconcile, update, or void payments
      allow update, delete: if isLeadership();
    }

    // =========================================================================
    // 3. NOTIFICATIONS COLLECTION (Broadcasts, Alerts, Approver Reminders)
    // =========================================================================
    match /notifications/{notificationId} {
      // Members can read notifications sent to them (via member_id or recipient) or broadcast 'all'
      allow read: if isAuthenticated() && (
        resource.data.member_id == request.auth.uid ||
        resource.data.recipient == request.auth.uid ||
        resource.data.recipient == 'all' ||
        isLeadership()
      );

      // Members can mark their own notifications as read
      // Leadership can manage notifications
      allow update: if isAuthenticated() && (
        isLeadership() ||
        (
          (resource.data.member_id == request.auth.uid || resource.data.recipient == request.auth.uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_read'])
        )
      );

      // Leadership or system triggers can create notifications (e.g. approver alerts)
      allow create: if isAuthenticated();

      // Only administrators can delete sent broadcasts
      allow delete: if isAdmin() || isChairperson();
    }

    // =========================================================================
    // 4. ORGANIZATION EXPENSES COLLECTION (Clause 5 Triple Authorization)
    // =========================================================================
    match /organization_expenses/{expenseId} {
      // All authenticated members can view the transparency expense ledger
      allow read: if isAuthenticated();

      // Financial leadership can record new expenses
      allow create: if isLeadership();

      // Leadership can sign approvals (Triple Authorization), reject, or update
      allow update: if isLeadership();

      // Only Chairperson or Admin can remove erroneous entries
      allow delete: if isChairperson() || isAdmin();
    }

    // =========================================================================
    // 5. MEMBER FEEDBACK & CONCERNS COLLECTION (Confidential to Admins)
    // =========================================================================
    match /feedback/{feedbackId} {
      // Submitting member can view their own feedback; Admins and Chairperson can view all
      allow read: if isAuthenticated() && (
        resource.data.member_id == request.auth.uid ||
        isAdmin() ||
        isChairperson()
      );

      // Any authenticated member can submit confidential feedback for themselves
      allow create: if isAuthenticated() && (
        request.resource.data.member_id == request.auth.uid ||
        isAdmin()
      );

      // Only Administrators and Chairperson can respond, change status, or resolve
      allow update: if isAdmin() || isChairperson();

      // Only Administrators and Chairperson can remove feedback
      allow delete: if isAdmin() || isChairperson();
    }

    // =========================================================================
    // 6. SECURITY & AUDIT TRAILS COLLECTION (Clause 6 Immutable Logs)
    // =========================================================================
    match /audit_logs/{logId} {
      // Strictly viewable by Administrators and Chairperson only
      // Regular members and Treasury CANNOT read audit trails
      allow read: if isAdmin() || isChairperson();

      // Authenticated users can write log entries to record auditable actions
      allow create: if isAuthenticated();

      // IMMUTABLE: Audit trails can NEVER be edited or deleted by anyone
      allow update, delete: if false;
    }

    // =========================================================================
    // 7. FORM SCHEMA COLLECTION (Dynamic Registration Schema)
    // =========================================================================
    match /form_schema/{schemaId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isChairperson();
    }

    // Default deny for unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
